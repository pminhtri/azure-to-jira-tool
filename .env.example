# --- Azure DevOps (source) ------------------------------------------------
# https://dev.azure.com/<org>/<project>
ADO_ORG=my-organization
ADO_PROJECT=My Project
# Personal Access Token with: Work Items (Read), Code (Read),
# Project and Team (Read), Analytics (Read).
# Create one at https://dev.azure.com/<org>/_usersSettings/tokens
ADO_PAT=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ADO_API_VERSION=7.1
# Set this only for an on-prem Azure DevOps Server, for example:
# ADO_BASE_URL=https://tfs.company.local/tfs/DefaultCollection

# --- Jira (target) --------------------------------------------------------
# Cloud:  https://your-site.atlassian.net
# Server: https://jira.your-company.com
JIRA_BASE_URL=https://your-site.atlassian.net

# Cloud: your login email, paired with an API token below.
# Server / Data Center with a Personal Access Token: leave this EMPTY so the
# token is sent as Bearer. Setting it switches to Basic auth.
JIRA_EMAIL=you@company.com

# Cloud token: https://id.atlassian.com/manage-profile/security/api-tokens
# Server PAT:  <jira>/secure/ViewProfile.jspa -> Personal Access Tokens
JIRA_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx

JIRA_PROJECT_KEY=PROJ

# Board used to create sprints. Empty means the first board that supports them.
# Kanban boards have no sprints. Run `deno task fields` to see the board type.
JIRA_BOARD_NAME=

# Both are inferred automatically; set them only to force a choice.
#   JIRA_DEPLOYMENT=cloud | server | auto
#   JIRA_AUTH=basic | bearer | auto

# --- Corporate CA / TLS ---------------------------------------------------
# Deno ships its own CA store and ignores the OS one, so an internal corporate
# CA (e.g. an on-prem Jira behind a company root CA) is not trusted by default
# and requests fail with `invalid peer certificate: UnknownIssuer`.
# Use the operating system certificate store:
#   DENO_TLS_CA_STORE=system
# ...or point Deno at an exported CA bundle instead:
#   DENO_CERT=/path/to/ca.pem

# --- Tuning ---------------------------------------------------------------
# Maximum concurrent requests per side
CONCURRENCY=4
# Skip attachments larger than this (Jira Cloud caps uploads at 10MB by default)
MAX_ATTACHMENT_MB=10
# Where exported data and migration state are stored
DATA_DIR=.data
STATE_DIR=.state
